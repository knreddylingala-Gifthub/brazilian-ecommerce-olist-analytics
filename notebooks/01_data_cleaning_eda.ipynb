import pandas as pd
import numpy as np

# Load datasets from extracted folder
data_path = '/content/olist_data/'
orders = pd.read_csv(data_path + 'olist_orders_dataset.csv')
items = pd.read_csv(data_path + 'olist_order_items_dataset.csv')
payments = pd.read_csv(data_path + 'olist_order_payments_dataset.csv')
products = pd.read_csv(data_path + 'olist_products_dataset.csv')
translation = pd.read_csv(data_path + 'product_category_name_translation.csv')
customers = pd.read_csv(data_path + 'olist_customers_dataset.csv')

# Preprocessing & translations (Cleaned fillna syntax)
products_translated = products.merge(translation, on='product_category_name', how='left')
products_translated['product_category_name_english'] = products_translated['product_category_name_english'].fillna('unassigned')

# Datetime conversion
datetime_cols = [
    'order_purchase_timestamp', 
    'order_approved_at', 
    'order_delivered_carrier_date', 
    'order_delivered_customer_date', 
    'order_estimated_delivery_date'
]
for col in datetime_cols:
    orders[col] = pd.to_datetime(orders[col])

# Feature engineering
orders['delivery_days'] = (orders['order_delivered_customer_date'] - orders['order_purchase_timestamp']).dt.days
orders['is_delayed'] = np.where(orders['order_delivered_customer_date'] > orders['order_estimated_delivery_date'], 1, 0)

# Merge Master Table
master_df = orders.merge(items, on='order_id', how='inner') \
                  .merge(products_translated, on='product_id', how='left') \
                  .merge(customers, on='customer_id', how='left')

# Save output
master_df.to_csv('olist_master_cleaned.csv', index=False)
print("Pipeline Complete! Saved as olist_master_cleaned.csv")
