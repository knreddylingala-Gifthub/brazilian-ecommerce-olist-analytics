import pandas as pd
import numpy as np

# 1. Load Olist raw CSV datasets
orders = pd.read_csv('olist_orders_dataset.csv')
items = pd.read_csv('olist_order_items_dataset.csv')
payments = pd.read_csv('olist_order_payments_dataset.csv')
products = pd.read_csv('olist_products_dataset.csv')
translation = pd.read_csv('product_category_name_translation.csv')
customers = pd.read_csv('olist_customers_dataset.csv')

# 2. Merge English category translations
products_translated = products.merge(translation, on='product_category_name', how='left')

# 3. Convert string columns to datetime
datetime_cols = [
    'order_purchase_timestamp', 
    'order_approved_at', 
    'order_delivered_carrier_date', 
    'order_delivered_customer_date', 
    'order_estimated_delivery_date'
]
for col in datetime_cols:
    orders[col] = pd.to_datetime(orders[col])

# 4. Feature Engineering: Delivery metrics & delay identification
orders['delivery_time_days'] = (orders['order_delivered_customer_date'] - orders['order_purchase_timestamp']).dt.days
orders['estimated_vs_actual_days'] = (orders['order_estimated_delivery_date'] - orders['order_delivered_customer_date']).dt.days
orders['is_delayed'] = np.where(orders['order_delivered_customer_date'] > orders['order_estimated_delivery_date'], 1, 0)

# 5. Build Master Flat Dataset for Analytics
master_df = orders.merge(items, on='order_id', how='inner') \
                  .merge(products_translated, on='product_id', how='left') \
                  .merge(customers, on='customer_id', how='left')

# 6. Save Processed File
master_df.to_csv('olist_master_cleaned.csv', index=False)
print("Data cleaning complete! File saved as olist_master_cleaned.csv")
